<?xml version="1.0" encoding="utf-8"?>
<!-- Только https и только системные сертификаты: пользовательские (установленные вручную) не доверяются,
     чтобы их нельзя было использовать для перехвата трафика. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
